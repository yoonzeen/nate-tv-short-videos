{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/service/api/photoslides/firstItems",
      "destination": "/api/photoslides/firstItems"
    },
    {
      "source": "/shortnews/service/api/photoslides/firstItems",
      "destination": "/api/photoslides/firstItems"
    }
  ],
  "functions": {
    "api/photoslides/firstItems.ts": {
      "maxDuration": 10,
      "includeFiles": "lib/**"
    }
  }
}
