{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/shortnews/api/news",
      "destination": "/api/news"
    }
  ],
  "functions": {
    "api/news.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
